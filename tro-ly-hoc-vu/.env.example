# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=troly
DB_PASSWORD=2692005
DB_QLSV=qlsv
DB_ASSISTANT=assistant

# ---------- Bảo mật ----------
# Chuỗi ngẫu nhiên dài (vd: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=thay_bang_chuoi_ngau_nhien
JWT_EXPIRE_MINUTES=480
INTERNAL_API_TOKEN=thay_bang_chuoi_ngau_nhien_khac

# ---------- Dịch vụ ----------
QLSV_API_URL=http://127.0.0.1:8001
QLSV_API_PORT=8001
ASSISTANT_API_PORT=8000
MCP_DAO_TAO_PORT=9101
MCP_CTSV_PORT=9102
MCP_TAI_CHINH_PORT=9103
MCP_QUY_CHE_PORT=9104
CORS_ORIGINS=http://localhost:5173

# Giờ "hiện tại" cố định cho demo (bỏ trống để dùng giờ hệ thống)
DEMO_NOW=2026-11-20T09:00:00+07:00
TEN_TRUONG=Trường Đại học [TÊN TRƯỜNG]

# ---------- LLM (qua LiteLLM) ----------
# Định dạng "<nha_cung_cap>/<ten_mo_hinh>", xem danh sách tại tài liệu LiteLLM.
# Mô hình phải hỗ trợ tool calling.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
# Điền khóa API theo nhà cung cấp bạn chọn (LiteLLM tự đọc các biến chuẩn):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Nếu dùng mô hình local qua Ollama:
OLLAMA_API_BASE=http://127.0.0.1:11434

# ---------- RAG ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/van_ban
CHUNK_MAX_TOKENS=512
RETRIEVE_TOP_K=5

# ---------- Agent ----------
AGENT_MAX_STEPS=6
AGENT_HISTORY_MESSAGES=20
ACTION_EXPIRE_MINUTES=10
