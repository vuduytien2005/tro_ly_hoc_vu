# Sao chép file này thành .env rồi điền giá trị. KHÔNG commit file .env.

# ---------- SQL Server ----------
# Tên máy chủ như ô "Server name" khi đăng nhập SSMS, vd: localhost\SQLEXPRESS01
DB_SERVER=localhost\SQLEXPRESS01
DB_DRIVER=ODBC Driver 18 for SQL Server
# Bỏ trống DB_USER và DB_PASSWORD -> đăng nhập bằng Windows Authentication.
# Muốn dùng SQL Server Authentication thì điền tài khoản SQL (vd: sa / mật khẩu).
DB_USER=
DB_PASSWORD=
# SQL Server cài trên máy dùng chứng chỉ tự ký -> cần tin cậy chứng chỉ
DB_TRUST_SERVER_CERTIFICATE=true
DB_QLSV=tlhv_qlsv
DB_ASSISTANT=tlhv_assistant

# ---------- Bảo mật ----------
# Chuỗi ngẫu nhiên dài (vd: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=thay_bang_chuoi_ngau_nhien
JWT_EXPIRE_MINUTES=480
INTERNAL_API_TOKEN=thay_bang_chuoi_ngau_nhien_khac

# ---------- Dịch vụ ----------
QLSV_API_URL=http://127.0.0.1:8001
QLSV_API_PORT=8001
ASSISTANT_API_PORT=8000
MCP_DAO_TAO_PORT=9101
MCP_CTSV_PORT=9102
MCP_TAI_CHINH_PORT=9103
MCP_QUY_CHE_PORT=9104
MCP_THU_VIEN_PORT=9105
CORS_ORIGINS=http://localhost:5173

# Giờ "hiện tại" cố định cho demo (bỏ trống để dùng giờ hệ thống)
DEMO_NOW=2026-11-20T09:00:00+07:00
TEN_TRUONG=Trường Đại học [TÊN TRƯỜNG]

# ---------- LLM (qua LiteLLM) ----------
# Định dạng "<nha_cung_cap>/<ten_mo_hinh>", xem danh sách tại tài liệu LiteLLM.
# Mô hình phải hỗ trợ tool calling. Mặc định dự án: Claude Opus 5.5.
# Miễn phí: gemini/gemini-flash-latest + GEMINI_API_KEY (https://aistudio.google.com).
LLM_MODEL=anthropic/claude-opus-5-5
# Bỏ trống = không gửi temperature (Claude Opus 5.5 trả lỗi 400 nếu có tham số này).
LLM_TEMPERATURE=
# Claude luôn "thinking" và token thinking tính vào giới hạn này -> để rộng.
LLM_MAX_TOKENS=16000
# (Tùy chọn) mô hình thử lại khi mô hình chính từ chối trả lời, vd anthropic/claude-opus-5
LLM_FALLBACK_MODEL=
# Số lần tự thử lại khi nhà cung cấp báo quá tải / vượt hạn mức (429).
LLM_NUM_RETRIES=2
# Gặp 429 (vượt hạn mức) thì chờ rồi gọi lại, tổng tối đa N giây/lượt; 0 = báo lỗi ngay.
# Gemini gói miễn phí (5 lượt/phút): nên đặt 90.
LLM_RATE_LIMIT_WAIT_SECONDS=0
# Điền khóa API theo nhà cung cấp bạn chọn (LiteLLM tự đọc các biến chuẩn):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Nếu dùng mô hình local qua Ollama:
OLLAMA_API_BASE=http://127.0.0.1:11434

# ---------- RAG ----------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=false
CHROMA_DIR=./data/chroma
UPLOAD_DIR=./data/van_ban
CHUNK_MAX_TOKENS=512
RETRIEVE_TOP_K=5

# ---------- Agent ----------
AGENT_MAX_STEPS=6
AGENT_HISTORY_MESSAGES=20
ACTION_EXPIRE_MINUTES=10
